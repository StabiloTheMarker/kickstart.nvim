#!/bin/sh
# Claude Code Pre/PostToolUse hook for Edit|Write|MultiEdit|NotebookEdit.
# When Claude runs in a Neovim terminal ($NVIM is set), report each edited file to
# lua/custom/claude_changes.lua there. Always exits 0 so it can never block Claude.
[ -n "$NVIM" ] || exit 0
command -v jq >/dev/null || exit 0

input=$(cat)
field() { printf '%s' "$input" | jq -r "$1 // empty" | sed "s/'/''/g"; }
event=$(field .hook_event_name)
path=$(field '.tool_input.file_path // .tool_input.notebook_path')
cwd=$(field .cwd)
[ -n "$path" ] || exit 0

timeout 2 nvim --server "$NVIM" --remote-expr \
  "luaeval('require(\"custom.claude_changes\").hook(_A[1], _A[2], _A[3])', ['$event', '$path', '$cwd'])" \
  >/dev/null 2>&1
exit 0
